# Copy to .env and fill in secrets. Loaded from the working directory.

# --- JIRA (required) ---
# Base URL with no trailing path, e.g. https://imh-internal.atlassian.net
JIRA_BASE_URL=https://imh-internal.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Project key for parent tickets and subtasks (e.g. PROJ).
JIRA_PROJECT_KEY=

# Deploy subtask type: set NAME or ID (at least one required).
JIRA_DEPLOY_ISSUE_TYPE_NAME=Deploy
# JIRA_DEPLOY_ISSUE_TYPE_ID=

# Comma-separated keywords; subtask summary must contain every keyword (default below).
# JIRA_RT_SUMMARY_KEYWORDS=review,test

# Status name on the R&T subtask when it is ready to pick up (default: To Do).
# JIRA_RT_STATUS_NAME=To Do

# Optional: Atlassian account id when assignee matching needs an override.
# JIRA_ACCOUNT_ID=
