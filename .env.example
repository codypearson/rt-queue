# Copy to .env and fill in secrets. Loaded from the working directory.

# --- GitHub (required) ---
GITHUB_TOKEN=
# Comma-separated owner/repo slugs to scan for open pull requests.
GITHUB_REPOSITORIES=inmotionhosting/product-catalog,inmotionhosting/powerpanel
# Optional: login to exclude as PR author (default: from GET /user).
# GITHUB_LOGIN=

# --- JIRA (required) ---
# Base URL with no trailing path, e.g. https://imh-internal.atlassian.net
JIRA_BASE_URL=https://imh-internal.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Parent ticket status required when a PR is queued (default: Pending Review).
# JIRA_PARENT_STATUS_NAME=Pending Review

# Deploy subtask type: set NAME or ID (at least one required).
# Subtasks whose summary is exactly "Deploy" (case-insensitive) are also
# treated as Deploy even when created as a Sub-task.
JIRA_DEPLOY_ISSUE_TYPE_NAME=Deploy
# JIRA_DEPLOY_ISSUE_TYPE_ID=

# Keyword groups separated by ';'; keywords within a group are comma-separated.
# A subtask matches when every keyword in at least one group appears in the summary.
# JIRA_RT_SUMMARY_KEYWORDS=review,test;code,review

# Ignored summaries: never a queue trigger, never a sibling blocker, never
# disqualifying history. Empty value disables ignoring. Same group format.
# JIRA_IGNORED_SUMMARY_KEYWORDS=stakeholder,review

# R&T subtask status(es) when ready to pick up (comma-separated).
# Default: To Do,Qualified
# JIRA_RT_STATUS_NAME=To Do,Qualified

# Optional: Atlassian account id when assignee matching needs an override.
# JIRA_ACCOUNT_ID=
